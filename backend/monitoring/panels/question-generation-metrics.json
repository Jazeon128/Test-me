[
  {
    "datasource": "Prometheus",
    "fieldConfig": {
      "defaults": {
        "color": {"mode": "palette-classic"},
        "custom": {
          "axisLabel": "Duration (seconds)",
          "drawStyle": "line",
          "fillOpacity": 10
        },
        "unit": "s"
      }
    },
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
    "id": 5,
    "targets": [
      {
        "expr": "histogram_quantile(0.95, rate(question_generation_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 {{provider}} - {{difficulty}}"
      },
      {
        "expr": "histogram_quantile(0.50, rate(question_generation_duration_seconds_bucket[5m]))",
        "legendFormat": "p50 {{provider}} - {{difficulty}}"
      }
    ],
    "title": "Question Generation Duration",
    "type": "timeseries"
  },
  {
    "datasource": "Prometheus",
    "fieldConfig": {
      "defaults": {
        "color": {"mode": "palette-classic"},
        "custom": {
          "axisLabel": "Tokens",
          "drawStyle": "line",
          "fillOpacity": 10
        },
        "unit": "short"
      }
    },
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
    "id": 6,
    "targets": [
      {
        "expr": "rate(ai_tokens_used_total{token_type=\"input\"}[5m])",
        "legendFormat": "Input - {{provider}} {{model}}"
      },
      {
        "expr": "rate(ai_tokens_used_total{token_type=\"output\"}[5m])",
        "legendFormat": "Output - {{provider}} {{model}}"
      }
    ],
    "title": "AI Token Usage Rate",
    "type": "timeseries"
  },
  {
    "datasource": "Prometheus",
    "fieldConfig": {
      "defaults": {
        "color": {"mode": "palette-classic"},
        "custom": {
          "axisLabel": "Cost (USD)",
          "drawStyle": "line",
          "fillOpacity": 10
        },
        "unit": "currencyUSD"
      }
    },
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
    "id": 7,
    "targets": [
      {
        "expr": "rate(ai_estimated_cost_usd[5m]) * 3600",
        "legendFormat": "{{provider}} {{model}} (per hour)"
      }
    ],
    "title": "Estimated AI Costs",
    "type": "timeseries"
  },
  {
    "datasource": "Prometheus",
    "fieldConfig": {
      "defaults": {
        "color": {"mode": "thresholds"},
        "custom": {},
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.9},
            {"color": "red", "value": 0.95}
          ]
        },
        "unit": "percentunit"
      }
    },
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
    "id": 8,
    "targets": [
      {
        "expr": "sum(rate(question_generation_total{status=\"success\"}[5m])) / sum(rate(question_generation_total[5m]))",
        "legendFormat": "Success Rate"
      }
    ],
    "title": "Question Generation Success Rate",
    "type": "gauge"
  }
]
