# pytest-benchmark configuration
# See: https://pytest-benchmark.readthedocs.io/en/latest/configuration.html

[benchmark]
# Disable garbage collection during benchmarks for more consistent results
disable_gc = true

# Minimum number of rounds to run each benchmark
min_rounds = 5

# Minimum time to spend on each benchmark (in seconds)
min_time = 0.000005

# Maximum time to spend on each benchmark (in seconds)
max_time = 1.0

# Calibration precision
calibration_precision = 10

# Warmup iterations
warmup = false
warmup_iterations = 100000

# Timer to use (time.perf_counter is most accurate)
timer = time.perf_counter

# Save benchmark data
save = true
save_data = true

# Autosave after each run
autosave = false

# Compare mode
compare = false
compare_fail = []

# Histogram generation
histogram = false

# Verbose output
verbose = false

# Sort benchmarks by
sort = "name"

# Columns to display
columns = ["min", "max", "mean", "stddev", "median", "iqr", "outliers", "ops", "rounds", "iterations"]

# Performance regression thresholds
# Fail if performance degrades by more than these percentages
# compare_fail = ["min:10%", "mean:10%", "max:20%"]
