[
  {
    "datasource": "Prometheus",
    "fieldConfig": {
      "defaults": {
        "color": {"mode": "palette-classic"},
        "custom": {
          "axisLabel": "Errors/sec",
          "drawStyle": "line",
          "fillOpacity": 20,
          "lineWidth": 2
        },
        "unit": "ops"
      }
    },
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
    "id": 3,
    "targets": [
      {
        "expr": "rate(errors_total[5m])",
        "legendFormat": "{{error_type}} - {{endpoint}}"
      }
    ],
    "title": "Error Rate by Type and Endpoint",
    "type": "timeseries"
  },
  {
    "datasource": "Prometheus",
    "fieldConfig": {
      "defaults": {
        "color": {"mode": "thresholds"},
        "custom": {},
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.01},
            {"color": "red", "value": 0.05}
          ]
        },
        "unit": "percentunit"
      }
    },
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
    "id": 4,
    "targets": [
      {
        "expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m])) / sum(rate(api_requests_total[5m]))",
        "legendFormat": "5xx Error Rate"
      },
      {
        "expr": "sum(rate(api_requests_total{status=~\"4..\"}[5m])) / sum(rate(api_requests_total[5m]))",
        "legendFormat": "4xx Error Rate"
      }
    ],
    "title": "HTTP Error Rate",
    "type": "timeseries"
  }
]
