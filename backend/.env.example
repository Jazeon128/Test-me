# Test Me environment example
# Copy to backend/.env for private environment configuration.
# Real keys never go in this file. Never commit backend/.env.
# Settings normally saves keys in the operating system (OS) credential store.
# Lookup order: credential store, environment, read-only legacy database value.

# Relative database and upload paths resolve against backend/.
DATABASE_URL=sqlite:///./test_me.db

# Supported artificial intelligence (AI) providers:
# anthropic, openai, gemini, openrouter. Code default: anthropic.
# Recommended setup: choose OpenRouter or Gemini in Settings.
# No key is required to start the app. Leave unused keys empty.
# API means application programming interface.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=anthropic
# Empty uses the provider default. Settings models override this default.
# Choose separate question generation and chat models in Settings.
AI_MODEL=

# Optional TypeSafe Jev source assessment, quality checks and canvas routing.
# Without routing, canvas can ask the user to choose a diagram template.
TYPESAFE_API_KEY=

HOST=127.0.0.1
PORT=8000
DEBUG=true
# This does not enable authentication or make public hosting ready.
SECRET_KEY=your-secret-key-change-in-production
# Cross-Origin Resource Sharing (CORS) allowed frontend origins.
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# File size limit in bytes: 10485760.
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Optional certificate authority (CA) bundle for intercepted
# HyperText Transfer Protocol Secure (HTTPS) connections.
CA_BUNDLE=
